# Optional proxy or comma-separated proxy pool for Google Trends requests
# TRENDS_PROXY=http://127.0.0.1:7890
# TRENDS_PROXIES=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# Optional SerpApi API key (only needed when trends.provider is "serpapi")
# TRENDS_SERPAPI_KEY=

# Optional SMTP email settings (only required if notifications.email.enabled is true)
# Gmail: smtp.gmail.com:587 (STARTTLS + App Password)
# QQ / 163 / Enterprise Mail: usually port 465 (SSL auto-detected)
TRENDS_SMTP_SERVER=smtp.gmail.com
TRENDS_SMTP_PORT=587
TRENDS_SENDER_EMAIL=
TRENDS_SENDER_PASSWORD=
# Supports comma-separated recipients, e.g. alice@example.com,bob@example.com
TRENDS_RECIPIENT_EMAIL=

# Optional Webhook channels
TRENDS_FEISHU_WEBHOOK=
TRENDS_WECOM_WEBHOOK=
TRENDS_WEBHOOK_URL=
